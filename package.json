{
  "name": "runlog-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local sports diary with image extraction, an agent tool loop and SQLite storage.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
