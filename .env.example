# Настройка бота: npm run setup:telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_BOT_USERNAME=

# Необязательно: путь к Codex, модель, часовой пояс, порт, каталог личных данных.
SPORT_CODEX_BIN=codex
SPORT_CODEX_MODEL=
SPORT_TIMEZONE=Asia/Saigon
SPORT_PORT=8787
RUNLOG_DATA_DIR=

# macOS: по умолчанию iCloud Drive/Shortcuts/runlog-health.json
RUNLOG_SYNC_FILE=
# Укажи точное имя источника, только если импорт сообщает о нескольких источниках.
RUNLOG_HEALTH_SOURCE=
